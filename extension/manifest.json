{
  "manifest_version": 3,
  "name": "MagicLens 词镜",
  "description": "把 magicbook 的阅读能力带到整个 Web：划词翻译、单词详解、认识/生词标记、词汇表与朗读，直连 moon-well。",
  "version": "0.4.0",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-extract.js", "content.js", "chat.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MagicLens 词镜",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
